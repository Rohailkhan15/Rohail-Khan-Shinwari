---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { getAllProjects } from '../../lib/sanity'

const filters = ['All', 'Live', 'Building', 'Concept']

const projects = (await getAllProjects()) || []
---

<BaseLayout title="Rohail — Projects">
  <section class="max-w-[1200px] mx-auto px-6 py-[120px]">
    <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-on-surface mb-12">
      <span class="animated-underline">Projects</span>
    </h1>

    <!-- Filter Bar -->
    <div class="mt-8 flex flex-wrap gap-3 mb-12">
      {filters.map(filter => (
        <button
          class={`font-label-caps text-label-caps rounded-full px-4 py-2 transition-colors ${
            filter === 'All'
              ? 'bg-primary text-on-primary'
              : 'bg-surface-variant text-on-surface hover:text-primary'
          }`}
          data-filter={filter}
        >
          {filter}
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(project => (
        <a href={`/projects/${project.slug.current}`}>
          <ProjectCard project={project} />
        </a>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="mt-12 hidden text-center">
      <p class="text-on-surface-variant">No projects found for this filter.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('[data-filter]')
  const cards = document.querySelectorAll('[data-status]')
  const emptyState = document.getElementById('empty-state')

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // Update button styles
      buttons.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary')
        b.classList.add('bg-surface-variant', 'text-on-surface')
      })
      button.classList.remove('bg-surface-variant', 'text-on-surface')
      button.classList.add('bg-primary', 'text-on-primary')

      // Filter projects
      const filter = button.getAttribute('data-filter')
      let visibleCount = 0

      cards.forEach(card => {
        const anchor = card.closest('a')
        if (filter === 'All') {
          anchor?.classList.remove('hidden')
          visibleCount++
        } else {
          const status = card.getAttribute('data-status')
          if (status?.toLowerCase() === filter?.toLowerCase()) {
            anchor?.classList.remove('hidden')
            visibleCount++
          } else {
            anchor?.classList.add('hidden')
          }
        }
      })

      // Show/hide empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden')
      } else {
        emptyState?.classList.add('hidden')
      }
    })
  })
</script>
