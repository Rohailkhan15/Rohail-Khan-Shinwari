---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getAllProjects } from '../../lib/sanity'
import type { Project } from '../../lib/sanity'

export async function getStaticPaths() {
  const projects = (await getAllProjects()) || []
  // Pass each project through props so detail pages don't re-fetch from Sanity
  return projects.map((project) => ({
    params: { slug: project.slug.current },
    props: { project },
  }))
}

const { project } = Astro.props as { project: Project }

if (!project) {
  return Astro.redirect('/404')
}

const statusColors = {
  live: 'bg-green-100 text-green-700',
  building: 'bg-yellow-100 text-yellow-700',
}
---

<BaseLayout
  title={`${project.title} — Project | Rohail Khan Shinwari`}
  description={project.description}
>
  <section class="py-8 sm:py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <!-- Back Link -->
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7" />
          <path d="M19 12H5" />
        </svg>
        Back to Projects
      </a>

      <!-- Project Header -->
      <div class="mt-8">
        <div class="mb-4 flex items-center gap-3">
          <span class={`rounded-full px-3 py-1 text-xs font-medium ${statusColors[project.status]}`}>
            {project.status}
          </span>
          <span class="text-sm text-muted">{project.date}</span>
        </div>
        <h1 class="font-display text-[28px] leading-tight sm:text-[36px] md:text-5xl font-bold">{project.title}</h1>
        <p class="mt-4 text-lg text-muted">{project.description}</p>
      </div>

      <!-- Tags -->
      <div class="mt-6 flex flex-wrap gap-2">
        {(project.tags || []).map(tag => (
          <span class="rounded-full bg-tag px-3 py-1 text-sm text-accent">
            {tag}
          </span>
        ))}
      </div>

      <!-- Links -->
      <div class="mt-8 flex flex-wrap gap-4">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-5 py-2.5 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            GitHub
          </a>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-surface transition-colors hover:bg-accent/90"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            Live Demo
          </a>
        )}
      </div>

      <!-- Long Description -->
      <div class="mt-12">
        <h2 class="font-display text-2xl font-bold">About</h2>
        <div class="mt-4 space-y-4 text-base leading-relaxed text-muted">
          <p>{project.longDescription}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
