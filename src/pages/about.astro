---
import BaseLayout from '../layouts/BaseLayout.astro'

const whatIDo = [
  {
    title: 'AI & Tech',
    description: 'Exploring machine learning, building intelligent systems, and staying at the forefront of technology.',
    icon: 'psychology',
  },
  {
    title: 'Writing & Ideas',
    description: 'Sharing thoughts on technology, startups, and the future through essays and build logs.',
    icon: 'edit',
  },
  {
    title: 'Building Products',
    description: 'Creating software that solves real problems, from Chrome extensions to full-stack applications.',
    icon: 'rocket_launch',
  },
  {
    title: 'Content Creation',
    description: 'Producing videos, articles, and resources to help others learn and grow.',
    icon: 'video_library',
  },
]

const currently = [
  'Studying AI at NUTech Islamabad',
  'Building NexChat Chrome Extension',
  'Reading about startups and product strategy',
  'Exploring large language models and their applications',
]

const email = 'Shinwarir098@gmail.com'
---

<BaseLayout title="Rohail Khan Shinwari — About">
  <!-- Hero -->
  <section class="max-w-[1200px] mx-auto px-6 py-[120px]">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:items-center">
      <!-- Photo -->
      <div class="flex justify-center md:justify-start">
        <div class="relative h-[320px] w-[320px] overflow-hidden rounded-full border border-outline-variant/20 p-2 bg-surface">
          <img
            src="/images/Rohail_black_proifle.jpeg"
            alt="Rohail Khan Shinwari"
            class="h-full w-full object-cover rounded-full grayscale hover:grayscale-0 transition-all duration-500"
            loading="eager"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="text-center md:text-left">
        <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-on-surface mb-6">
          <span class="animated-underline">About Me</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-4">
          AI student, builder, and future founder.
        </p>
        <p class="font-body-md text-body-md text-on-surface-variant">
          I'm on a mission to build things that matter and share what I learn along the way.
        </p>
      </div>
    </div>
  </section>

  <!-- My Story -->
  <section class="max-w-[800px] mx-auto px-6 py-[120px]">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">My Story</span>
    </h2>
    <div class="space-y-6 font-body-lg text-body-lg text-on-surface-variant">
      <p>
        I'm an AI student at NUTech Islamabad, where I'm diving deep into machine learning,
        neural networks, and the future of intelligent systems. But my journey isn't just about
        academics—it's about building.
      </p>
      <p>
        I've always had a builder mindset. Whether it's a Chrome extension, a full-stack application,
        or a new system for organizing knowledge, I love taking ideas from concept to reality.
        I believe the best way to learn is by doing, and I'm constantly experimenting with new
        technologies and approaches.
      </p>
      <p>
        Beyond code, I'm passionate about startups, content creation, and writing. I think deeply
        about the intersection of technology and human potential. Writing helps me clarify my thoughts,
        and sharing those thoughts helps me connect with others who are on similar journeys.
      </p>
      <p>
        My long-term goal is ambitious but clear: I want to build a software company that creates
        products people genuinely love. Every project I take on, every article I write, and every
        skill I learn is a step toward that vision.
      </p>
    </div>
  </section>

  <!-- What I Do -->
  <section class="max-w-[1200px] mx-auto px-6 py-[120px]">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">What I Do</span>
    </h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {whatIDo.map(item => (
        <div class="group bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1">
          <div class="mb-4 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
            <span class="material-symbols-outlined">{item.icon}</span>
          </div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">{item.title}</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Currently -->
  <section class="max-w-[800px] mx-auto px-6 py-[120px]">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">Currently</span>
    </h2>
    <div class="bg-surface-container-low rounded-2xl p-8 border border-outline-variant/10 font-code-sm text-code-sm">
      <div class="text-outline mb-4">/* Current Focus */</div>
      <ul class="space-y-3 text-on-surface-variant">
        {currently.map(item => (
          <li class="flex items-start">
            <span class="text-primary mr-2">→</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Reach Me -->
  <section class="max-w-[800px] mx-auto px-6 py-[120px]">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">Reach Me</span>
    </h2>
    <div class="mt-8">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-2 font-body-lg text-body-lg text-primary hover:text-primary transition-colors group"
      >
        <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">mail</span>
        {email}
      </a>
      <p class="mt-4 font-body-md text-body-md text-on-surface-variant">
        You can also find me on social media in the footer below.
      </p>
    </div>
  </section>
</BaseLayout>
