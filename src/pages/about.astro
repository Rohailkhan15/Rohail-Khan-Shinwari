---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'

const whatIDo = [
  {
    title: 'AI & Tech',
    description: 'Exploring machine learning, building intelligent systems, and staying at the forefront of technology.',
    icon: 'psychology',
  },
  {
    title: 'Writing & Ideas',
    description: 'Sharing thoughts on technology, startups, and the future through essays and build logs.',
    icon: 'edit',
  },
  {
    title: 'Building Products',
    description: 'Creating software that solves real problems, from Chrome extensions to full-stack applications.',
    icon: 'rocket_launch',
  },
  {
    title: 'Content Creation',
    description: 'Producing videos, articles, and resources to help others learn and grow.',
    icon: 'video_library',
  },
]

const currently = [
  'Studying AI at NUTech Islamabad',
  'Building NexChat Chrome Extension',
  'Reading about startups and product strategy',
  'Exploring large language models and their applications',
]

const email = 'Shinwarir098@gmail.com'
---

<BaseLayout
  title="About Me — AI Student & Builder | Rohail Khan Shinwari"
  description="Get to know Rohail Khan Shinwari — AI student at NUTech Islamabad, freelancer, content creator, and builder of web apps and AI automations."
>
  <!-- Ambient Background Orbs -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-[10%] right-[-100px] w-[400px] h-[400px] rounded-full bg-primary/[0.04] blur-[100px] animate-orb-drift hidden md:block"></div>
    <div class="absolute bottom-[20%] left-[-80px] w-[350px] h-[350px] rounded-full bg-secondary/[0.03] blur-[100px] animate-orb-drift hidden md:block" style="animation-delay: -4s;"></div>
  </div>

  <!-- Hero -->
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12 relative z-10 reveal">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:items-center">
      <!-- Photo -->
      <div class="flex justify-center md:justify-start">
        <div class="relative">
          <div class="absolute inset-0 w-[200px] h-[200px] sm:w-[240px] sm:h-[240px] md:w-[320px] md:h-[320px] rounded-full bg-gradient-to-br from-primary/20 via-secondary/10 to-primary/5 animate-glow-pulse"></div>
          <div class="h-[200px] w-[200px] sm:h-[240px] sm:w-[240px] md:h-[320px] md:w-[320px] overflow-hidden rounded-full border border-white/[0.1] p-2 bg-surface relative z-10">
            <img
              src="/images/Rohail_black_proifle.jpeg"
              alt="Rohail Khan Shinwari"
              class="h-full w-full object-cover rounded-full grayscale hover:grayscale-0 transition-all duration-500"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="text-center md:text-left">
        <div class="font-label-caps text-label-caps text-primary bg-primary-container/10 px-3 py-1 rounded-full mb-6 border border-primary/20 inline-block">
          AI STUDENT &amp; BUILDER
        </div>
        <h1 class="font-display text-[28px] leading-tight sm:text-[36px] md:text-[48px] lg:text-[64px] font-bold text-on-surface mb-6">
          <span class="animated-underline">About Me</span>
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant">
          I'm 3 semesters into an AI degree and several years into an always-build mindset. I make things — websites, automations, videos, essays — then talk about how I made them. Not because I have it all figured out, but because figuring it out in public is more useful than figuring it out alone.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[200px] mx-auto h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent my-4"></div>

  <!-- My Story -->
  <section class="max-w-[800px] mx-auto px-4 sm:px-6 py-8 sm:py-12 relative z-10 reveal">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">My Story</span>
    </h2>
    <div class="space-y-6 font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
      <p>
        I'm an AI student at NUTech Islamabad, spending my days learning how intelligent
      systems actually work under the hood. But the classroom is only half the education — the
      other half happens whenever I sit down to build something and figure out why it doesn't
      work yet.
      </p>
      <p>
        Right now that means backend web development and AI automations — the two things I'm
      learning fastest and freelancing at the same time, because building for real clients teaches
      you things a course never will. I'm a problem solver at the core: give me a messy workflow
      or a slow process, and I'll find a way to make it faster, cleaner, or automatic.
      </p>
      <p>
        Beyond code, I'm passionate about startups, content creation, and writing. I'm a creator across almost every medium I can get my hands on — photography,
      videography, cinematography, video editing, and writing. Writing helps me clarify my thoughts,
      and sharing those thoughts helps me connect with others who are on similar journeys. 
      I also read constantly — it's where most of my ideas actually come from.
      </p>
      <p>
        I am on a mission to create products people genuinely rely
      on. Every automation I ship, every client project I take on, and every piece I write or film
      is part of that same trajectory — I'm just getting the reps in early.
      </p>
    </div>
  </section>

  <div class="max-w-[200px] mx-auto h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent my-4"></div>

  <!-- Reach Me -->
  <section class="max-w-[800px] mx-auto px-4 sm:px-6 py-8 sm:py-12 relative z-10 reveal">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">Reach Me</span>
    </h2>
    <div class="mt-8">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-2 font-body-lg text-body-lg text-primary hover:text-primary/80 transition-colors group"
      >
        <Icon name="mail" size={20} class="group-hover:translate-x-1 transition-transform" />
        {email}
      </a>
      <p class="mt-4 font-body-md text-body-md text-on-surface-variant">
        You can also find me on social media in the footer below.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Reveal via IntersectionObserver (no scroll listeners)
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          obs.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -100px 0px', threshold: 0 });
    reveals.forEach(el => revealObserver.observe(el));
  } else {
    reveals.forEach(el => el.classList.add('active'));
  }
</script>
