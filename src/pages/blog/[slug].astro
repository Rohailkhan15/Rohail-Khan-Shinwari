---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { sanityClient, type BlogPost } from '../../lib/sanity'
import { toHTML } from '@portabletext/to-html'

export async function getStaticPaths() {
  // One query for all posts (including body) instead of N+1 per-slug fetches.
  // Data is passed via props, so each page renders without extra requests.
  const posts: BlogPost[] = await sanityClient.fetch(`*[_type == "blogPost"] | order(publishedAt desc) {
    _id,
    title,
    slug,
    publishedAt,
    excerpt,
    category,
    tags,
    body,
    readingTime
  }`)
  return (posts || []).map((post) => ({
    params: { slug: post.slug.current },
    props: { post },
  }))
}

const { post } = Astro.props as { post: BlogPost }

if (!post) {
  return Astro.redirect('/404')
}

const categoryColors = {
  'Essay': 'bg-blue-100 text-blue-700',
  'Build Log': 'bg-green-100 text-green-700',
  'Micro-thought': 'bg-orange-100 text-orange-700',
}

const formattedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})

const portableTextComponents = {
  block: {
    normal: ({ children }: any) => `<p class="mb-4">${children}</p>`,
    h1: ({ children }: any) => `<h1 class="text-3xl font-bold mb-4">${children}</h1>`,
    h2: ({ children }: any) => `<h2 class="text-2xl font-bold mb-4">${children}</h2>`,
    h3: ({ children }: any) => `<h3 class="text-xl font-bold mb-4">${children}</h3>`,
  },
  types: {
    code: ({ value }: any) => {
      return `<pre class="my-4 overflow-x-auto rounded-lg bg-surface p-4"><code class="font-mono text-sm">${value.code}</code></pre>`
    },
  },
  marks: {
    link: ({ children, value }: any) => {
      return `<a href="${value.href}" class="text-accent hover:text-accent-2 underline">${children}</a>`
    },
  },
}

const bodyHtml = post.body ? toHTML(post.body, { components: portableTextComponents }) : '<p>No content</p>'

// BlogPosting structured data for rich results
const postURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
const wordCount = (post.body || [])
  .flatMap((block: any) => (block.children || []).map((child: any) => child.text ?? ''))
  .join(' ')
  .split(/\s+/)
  .filter(Boolean)
  .length
const blogPostingJsonLd = {
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  articleSection: post.category,
  keywords: (post.tags || []).join(', '),
  wordCount,
  author: { '@type': 'Person', name: 'Rohail Khan Shinwari' },
  publisher: { '@type': 'Person', name: 'Rohail Khan Shinwari' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postURL },
}
---

<BaseLayout
  title={`${post.title} — Blog | Rohail Khan Shinwari`}
  description={post.excerpt}
  type="article"
  publishedAt={post.publishedAt}
  extraJsonLd={blogPostingJsonLd}
>
  <article class="py-8 sm:py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <!-- Back Link -->
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7" />
          <path d="M19 12H5" />
        </svg>
        Back to Blog
      </a>

      <!-- Header -->
      <header class="mt-8">
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <span class={`rounded-full px-3 py-1 text-xs font-medium ${categoryColors[post.category]}`}>
            {post.category}
          </span>
          <span class="text-sm text-muted">{formattedDate}</span>
          <span class="text-sm text-muted">·</span>
          <span class="text-sm text-muted">{post.readingTime || 5} min read</span>
        </div>
        
        <h1 class="font-display text-[28px] leading-tight sm:text-[36px] md:text-5xl font-bold">{post.title}</h1>
        <p class="mt-4 text-lg text-muted">{post.excerpt}</p>
      </header>

      <!-- Body Content -->
      <div class="prose prose-lg mt-12 max-w-none text-text">
        <div set:html={bodyHtml} />
      </div>

      <!-- Tags -->
      {post.tags && post.tags.length > 0 && (
        <div class="mt-12 flex flex-wrap gap-2">
          {post.tags.map(tag => (
            <span class="rounded-full bg-tag px-3 py-1 text-sm text-accent">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Share Links -->
      <div class="mt-8 border-t border-border pt-8">
        <h3 class="font-display text-lg font-semibold">Share this post</h3>
        <div class="mt-4 flex gap-4">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-border bg-surface p-3 text-muted transition-colors hover:text-accent"
            aria-label="Share on Twitter"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
            </svg>
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-border bg-surface p-3 text-muted transition-colors hover:text-accent"
            aria-label="Share on LinkedIn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect width="4" height="12" x="2" y="9" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </a>
          <button
            id="copy-link"
            class="rounded-full border border-border bg-surface p-3 text-muted transition-colors hover:text-accent"
            aria-label="Copy link"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m7 15 5 5 5-5" />
              <path d="M12 4V20" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const copyButton = document.getElementById('copy-link')
  
  if (copyButton) {
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href)
        copyButton.classList.add('text-accent')
        copyButton.classList.remove('text-muted')
        setTimeout(() => {
          copyButton.classList.remove('text-accent')
          copyButton.classList.add('text-muted')
        }, 2000)
      } catch (err) {
        console.error('Failed to copy link:', err)
      }
    })
  }
</script>
