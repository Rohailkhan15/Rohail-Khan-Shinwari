---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogCard from '../../components/BlogCard.astro'
import { getAllPosts } from '../../lib/sanity'

const categories = ['All', 'Essay', 'Build Log', 'Micro-thought'] as const
const currentCategory = 'All'

const allPosts = (await getAllPosts()) || []
---

<BaseLayout title="Rohail Khan Shinwari — Blog">
  <section class="max-w-[1200px] mx-auto px-6 py-12">
    <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-on-surface mb-12">
      <span class="animated-underline">Blog</span>
    </h1>

    <!-- Category Filter -->
    <div class="mt-8 flex flex-wrap gap-3 mb-12">
      {categories.map(category => (
        <button
          class={`font-label-caps text-label-caps rounded-full px-4 py-2 transition-colors ${
            currentCategory === category
              ? 'bg-primary text-on-primary'
              : 'bg-surface-variant text-on-surface hover:text-primary'
          }`}
          data-category={category}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {allPosts.map(post => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="mt-12 text-center hidden">
      <p class="text-on-surface-variant">No posts found in this category.</p>
    </div>

    <!-- No Posts State (when Sanity has no content yet) -->
    {allPosts.length === 0 && (
      <div class="mt-12 rounded-2xl border border-outline-variant/10 bg-surface-container-lowest p-8 text-center">
        <p class="text-on-surface-variant">
          No blog posts yet. Add content in your Sanity CMS to see them here.
        </p>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('[data-category]')
  const cards = document.querySelectorAll('[data-post-category]')
  const emptyState = document.getElementById('empty-state')

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // Update button styles
      buttons.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary')
        b.classList.add('bg-surface-variant', 'text-on-surface')
      })
      button.classList.remove('bg-surface-variant', 'text-on-surface')
      button.classList.add('bg-primary', 'text-on-primary')

      // Filter posts
      const category = button.getAttribute('data-category')
      let visibleCount = 0

      cards.forEach(card => {
        if (category === 'All') {
          card.classList.remove('hidden')
          visibleCount++
        } else {
          const postCategory = card.getAttribute('data-post-category')
          if (postCategory === category) {
            card.classList.remove('hidden')
            visibleCount++
          } else {
            card.classList.add('hidden')
          }
        }
      })

      // Show/hide empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden')
      } else {
        emptyState?.classList.add('hidden')
      }
    })
  })
</script>
