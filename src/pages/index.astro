---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getAllProjects, getAllPosts } from '../lib/sanity'

const allProjects = await getAllProjects()
const featuredProjects = (allProjects || []).filter(p => p.featured).slice(0, 3)

const allPosts = await getAllPosts()
const latestPosts = (allPosts || []).slice(0, 3)
---

<BaseLayout title="Rohail Khan Shinwari — Built for the future.">
  <!-- Ambient Background Orbs -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-[10%] right-[-100px] w-[400px] h-[400px] rounded-full bg-primary/[0.04] blur-[100px] animate-orb-drift"></div>
    <div class="absolute bottom-[20%] left-[-80px] w-[350px] h-[350px] rounded-full bg-secondary/[0.03] blur-[100px] animate-orb-drift" style="animation-delay: -4s;"></div>
    <div class="absolute top-[60%] right-[20%] w-[250px] h-[250px] rounded-full bg-primary/[0.02] blur-[80px] animate-orb-drift" style="animation-delay: -8s;"></div>
  </div>

  <!-- Hero Section -->
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12 md:py-[60px] min-h-0 md:min-h-[300px] flex items-center reveal relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center w-full">
      <!-- Left: Photo -->
      <div class="lg:col-span-5 flex justify-center lg:justify-start relative mb-8 lg:mb-0">
        <div class="absolute inset-0 hero-gradient scale-[1.5] -z-10"></div>
        <div class="relative">
          <div class="absolute inset-0 w-[200px] h-[200px] sm:w-[240px] sm:h-[240px] md:w-[280px] md:h-[280px] rounded-full bg-gradient-to-br from-primary/20 via-secondary/10 to-primary/5 animate-glow-pulse"></div>
          <div class="w-[200px] h-[200px] sm:w-[240px] sm:h-[240px] md:w-[280px] md:h-[280px] rounded-full border border-white/[0.1] p-2 overflow-hidden bg-surface relative z-10">
            <img
              src="/images/Rohail_black_proifle.jpeg"
              alt="Rohail Khan Shinwari"
              class="w-full h-full object-cover rounded-full grayscale hover:grayscale-0 transition-all duration-500"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="lg:col-span-7 flex flex-col items-center text-center lg:items-start lg:text-left" style="transition-delay: 0.2s;">
        <div class="font-label-caps text-label-caps text-primary bg-primary-container/10 px-3 py-1 rounded-full mb-6 border border-primary/20 inline-block">
          Creative &amp; Developer </div>
        <h1 class="font-display text-[28px] leading-tight sm:text-[36px] md:text-[48px] lg:text-[64px] font-bold tracking-tight text-on-surface mb-4">
          Hi, I'm Rohail Khan Shinwari
        </h1>
        <h2 class="font-display text-lg sm:text-xl md:text-2xl text-on-surface-variant mb-6 h-[32px] sm:h-[40px]" id="typewriter-container">
          <span id="typewriter-text"></span><span class="typewriter-cursor"></span>
        </h2>
        <p class="font-body text-sm sm:text-base md:text-lg text-on-surface-variant max-w-xl mb-8 sm:mb-10">
          3rd-semester AI student building web apps and AI automations — and freelancing both. When I'm not shipping, I'm creating: photography, video, and writing across Instagram, YouTube, X, LinkedIn, Substack, and this blog.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto">
          <a
            class="inline-flex justify-center items-center bg-primary text-on-primary px-8 py-4 rounded-full font-body-md text-body-md hover:bg-on-primary-fixed-variant transition-colors group"
            href="/projects"
          >
            View Projects
            <span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
          </a>
          <a
            class="inline-flex justify-center items-center bg-transparent border-2 border-primary text-primary px-8 py-4 rounded-full font-body-md text-body-md hover:bg-primary/5 transition-colors"
            href="/blog"
          >
            Read Blog
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-[200px] mx-auto h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent my-4"></div>

  <!-- What I'm Building -->
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12 reveal">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">What I'm Building</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects && featuredProjects.length > 0 ? (
        featuredProjects.map((project, index) => (
          <a
            href={`/projects/${project.slug.current}`}
            class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden"
            style={`animation-delay: ${(index + 1) * 0.1}s`}
          >
            <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-[100px] -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
              <span class="material-symbols-outlined">psychology</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">{project.title}</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6">{project.description}</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {(project.tags || []).slice(0, 2).map(tag => (
                <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      ) : (
        // Fallback static cards if no projects
        <>
          <a class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" href="/projects" style="animation-delay: 0.1s">
            <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-[100px] -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
              <span class="material-symbols-outlined">psychology</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">NeuroCanvas</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6">A visual node-based editor for orchestrating local LLM pipelines.</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">React</span>
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">Python</span>
            </div>
          </a>
          <a class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" href="/projects" style="animation-delay: 0.2s">
            <div class="absolute bottom-0 right-0 w-32 h-32 border border-outline-variant/20 rounded-tl-full -mb-16 -mr-16 transition-transform group-hover:scale-110"></div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
              <span class="material-symbols-outlined">data_object</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Syntax UI</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6">A minimalist design system for technical dashboards.</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">Tailwind</span>
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">Figma</span>
            </div>
          </a>
          <a class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" href="/projects" style="animation-delay: 0.3s">
            <div class="absolute top-1/2 left-1/2 w-48 h-48 bg-secondary/5 rounded-full -translate-x-1/2 -translate-y-1/2 scale-0 group-hover:scale-100 transition-transform duration-500"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                <span class="material-symbols-outlined">robot_2</span>
              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Echo Bot</h3>
              <p class="font-body-md text-body-md text-on-surface-variant mb-6">An autonomous research agent for documentation synthesis.</p>
              <div class="flex flex-wrap gap-2 mt-auto">
                <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">LangChain</span>
                <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">TypeScript</span>
              </div>
            </div>
          </a>
        </>
      )}
    </div>
    <div class="mt-12">
      <a
        class="inline-flex items-center text-primary font-body-md text-body-md hover:underline group"
        href="/projects"
      >
        View all projects
        <span class="material-symbols-outlined ml-1 text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>
  </section>

  <div class="max-w-[200px] mx-auto h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent my-4"></div>

  <!-- Latest Writing -->
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12 reveal">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-12">
      <span class="animated-underline">From the Blog</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestPosts && latestPosts.length > 0 ? (
        latestPosts.map((post, index) => (
          <a
            href={`/blog/${post.slug.current}`}
            class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 w-24 h-24 bg-secondary/5 rounded-bl-[100px] -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center mb-6 text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors">
              <span class="material-symbols-outlined">article</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">{post.title}</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">{post.excerpt}</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">
                {post.category}
              </span>
            </div>
          </a>
        ))
      ) : (
        // Fallback static cards if no posts
        <>
          <a class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" href="/blog">
            <div class="absolute top-0 right-0 w-24 h-24 bg-secondary/5 rounded-bl-[100px] -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center mb-6 text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors">
              <span class="material-symbols-outlined">article</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">The Future of AI Interfaces</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">Exploring how generative AI is reshaping the way we interact with software.</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">Essay</span>
            </div>
          </a>
          <a class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" href="/blog">
            <div class="absolute bottom-0 right-0 w-32 h-32 border border-outline-variant/20 rounded-tl-full -mb-16 -mr-16 transition-transform group-hover:scale-110"></div>
            <div class="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center mb-6 text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors">
              <span class="material-symbols-outlined">edit_note</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Building with Astro</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">A deep dive into building performant static sites with Astro.</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">Build Log</span>
            </div>
          </a>
          <a class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" href="/blog">
            <div class="absolute top-1/2 left-1/2 w-48 h-48 bg-secondary/5 rounded-full -translate-x-1/2 -translate-y-1/2 scale-0 group-hover:scale-100 transition-transform duration-500"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center mb-6 text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors">
                <span class="material-symbols-outlined">auto_stories</span>
              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Design Systems 101</h3>
              <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">Creating scalable and maintainable design systems for modern web applications.</p>
              <div class="flex flex-wrap gap-2 mt-auto">
                <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full whitespace-nowrap">Essay</span>
              </div>
            </div>
          </a>
        </>
      )}
    </div>
    <div class="mt-12">
      <a
        class="inline-flex items-center text-primary font-body-md text-body-md hover:underline group"
        href="/blog"
      >
        Read all posts
        <span class="material-symbols-outlined ml-1 text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>
  </section>

  <div class="max-w-[200px] mx-auto h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent my-4"></div>

  <!-- About Teaser -->
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12 reveal">
    <div class="bg-surface-container-low rounded-2xl p-5 sm:p-8 md:p-12 border border-outline-variant/10 hover:border-primary/30 hover:shadow-[0_0_15px_0] hover:shadow-primary/20 transition-all duration-300">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-headline-md text-headline-md text-on-surface mb-6">
            <span class="animated-underline">The Philosophy</span>
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-6">
            I don't chase tools — I chase problems. Whether it's an AI automation that saves someone ten hours a week, a web app that finally works the way it should, or a video that explains an idea better than a paragraph ever could — the medium changes, the mindset doesn't. Build it, ship it, learn from it, build the next thing.
          </p>
          <a
            class="inline-flex items-center text-primary font-body-md text-body-md hover:underline group"
            href="/about"
          >
            More about me
            <span class="material-symbols-outlined ml-1 text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-4 sm:p-6 border border-outline-variant/10 font-code-sm text-xs sm:text-sm overflow-x-hidden">
          <div class="text-outline mb-4">/* How I Operate */</div>
          <ul class="space-y-3 text-on-surface-variant break-words">
            <li class="flex items-start">
              <span class="text-primary mr-2 flex-shrink-0">→</span>
              <span>Build in public. The audience is part of the work.</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2 flex-shrink-0">→</span>
              <span>Ship first, polish later — momentum beats perfection.</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2 flex-shrink-0">→</span>
              <span>If it can be automated, it should be.</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2 flex-shrink-0">→</span>
              <span>Document the process — someone else needs it too.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Enhanced Scroll Reveal with stagger
  function reveal() {
    const reveals = document.querySelectorAll(".reveal");
    for (let i = 0; i < reveals.length; i++) {
      const windowHeight = window.innerHeight;
      const elementTop = reveals[i].getBoundingClientRect().top;
      const elementVisible = 100;
      if (elementTop < windowHeight - elementVisible) {
        reveals[i].classList.add("active");
        // Stagger children animations
        const children = reveals[i].querySelectorAll('[class*="hover:"]');
        children.forEach((child, index) => {
          child.style.transitionDelay = `${index * 80}ms`;
        });
      }
    }
  }
  window.addEventListener("scroll", reveal);
  // Trigger on load
  reveal();

  // Typewriter Effect Logic
  const phrases = [
    "Building intelligent interfaces.",
    "Designing systemic clarity.",
    "Engineering the future."
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let typingDelay = 100;
  let erasingDelay = 50;
  let newPhraseDelay = 2000;

  const textElement = document.getElementById('typewriter-text');

  function type() {
    const currentPhrase = phrases[phraseIndex];

    if (isDeleting) {
      textElement.textContent = currentPhrase.substring(0, charIndex - 1);
      charIndex--;
    } else {
      textElement.textContent = currentPhrase.substring(0, charIndex + 1);
      charIndex++;
    }

    let delay = isDeleting ? erasingDelay : typingDelay;

    if (!isDeleting && charIndex === currentPhrase.length) {
      delay = newPhraseDelay;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      delay = 500;
    }

    setTimeout(type, delay);
  }

  // Start typewriter after a short delay
  setTimeout(type, 1000);
</script>
