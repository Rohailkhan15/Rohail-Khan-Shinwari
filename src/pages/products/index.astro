---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCard from '../../components/ProductCard.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import { getAllProducts } from '../../lib/sanity'

const filters = ['All', 'Live', 'Building', 'Concept']

const products = (await getAllProducts()) || []
---

<BaseLayout title="Rohail Khan Shinwari — Products">
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="font-display text-3xl font-bold md:text-4xl">Products</h1>

      <!-- Filter Bar -->
      <div class="mt-8 flex flex-wrap gap-2">
        {filters.map(filter => (
          <button
            class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
              filter === 'All'
                ? 'bg-accent text-surface'
                : 'bg-surface text-muted hover:text-text'
            }`}
            data-filter={filter}
          >
            {filter}
          </button>
        ))}
      </div>

      <!-- Products Grid -->
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map(product => (
          <a href={`/products/${product.slug.current}`}>
            <ProductCard product={product} />
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="mt-12 hidden text-center">
        <p class="text-muted">No products found for this filter.</p>
      </div>

      <!-- No Products State (when Sanity has no content yet) -->
      {products.length === 0 && (
        <div class="mt-12 rounded-2xl border border-border bg-surface p-8 text-center">
          <p class="text-muted">
            No products yet. Add content in your Sanity CMS to see them here.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('[data-filter]')
  const cards = document.querySelectorAll('[data-status]')
  const emptyState = document.getElementById('empty-state')

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // Update button styles
      buttons.forEach(b => {
        b.classList.remove('bg-accent', 'text-surface')
        b.classList.add('bg-surface', 'text-muted')
      })
      button.classList.remove('bg-surface', 'text-muted')
      button.classList.add('bg-accent', 'text-surface')

      // Filter products
      const filter = button.getAttribute('data-filter')
      let visibleCount = 0

      cards.forEach(card => {
        const anchor = card.closest('a')
        if (filter === 'All') {
          anchor?.classList.remove('hidden')
          visibleCount++
        } else {
          const status = card.getAttribute('data-status')
          if (status?.toLowerCase() === filter?.toLowerCase()) {
            anchor?.classList.remove('hidden')
            visibleCount++
          } else {
            anchor?.classList.add('hidden')
          }
        }
      })

      // Show/hide empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden')
      } else {
        emptyState?.classList.add('hidden')
      }
    })
  })
</script>
