---
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Projects', href: '/projects' },
  { name: 'Blog', href: '/blog' },
  { name: 'Products', href: '/products' },
]
---

<header
  id="navbar"
  class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/10 transition-all duration-300"
>
  <div class="flex justify-between items-center px-6 py-4 max-w-[1200px] mx-auto md:px-6">
    <a href="/" class="font-headline-md text-headline-md font-bold text-on-surface hover:opacity-80 transition-opacity">
      Rohail
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex gap-6 items-center">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="font-body-md text-body-md md:font-headline-sm md:text-headline-sm text-on-surface-variant hover:text-primary transition-colors"
        >
          {link.name}
        </a>
      ))}
      <button
        id="connect-btn"
        class="bg-primary text-on-primary px-6 py-2 rounded-full font-body-md text-body-md hover:bg-on-primary-fixed-variant transition-colors items-center gap-2 inline-flex"
      >
        Let's Connect
        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
      </button>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      id="menu-btn"
      class="md:hidden text-on-surface"
      aria-label="Toggle menu"
    >
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 right-0 z-50 w-64 transform bg-surface shadow-lg transition-transform duration-300 md:hidden translate-x-full"
  >
    <div class="flex flex-col gap-6 p-6 pt-20">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="text-base font-medium text-on-surface-variant hover:text-primary transition-colors"
        >
          {link.name}
        </a>
      ))}
      <button
        id="mobile-connect-btn"
        class="rounded-full bg-primary px-5 py-3 text-sm font-medium text-on-primary transition-colors hover:bg-on-primary-fixed-variant"
      >
        Let's Connect
      </button>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const connectBtn = document.getElementById('connect-btn');
  const mobileConnectBtn = document.getElementById('mobile-connect-btn');

  let isMenuOpen = false;

  // Mobile menu toggle
  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  }

  // Scroll to footer
  function scrollToFooter() {
    const footer = document.querySelector('footer');
    if (footer) {
      footer.scrollIntoView({ behavior: 'smooth' });
    }
    // Close mobile menu if open
    if (isMenuOpen) {
      toggleMenu();
    }
  }

  // Event listeners
  menuBtn.addEventListener('click', toggleMenu);
  connectBtn.addEventListener('click', scrollToFooter);
  mobileConnectBtn.addEventListener('click', scrollToFooter);

  // Close menu when clicking a link
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });
</script>
