---
import Icon from './Icon.astro'

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: 'Projects', href: '/projects' },
  { name: 'Products', href: '/products' },
  { name: 'About', href: '/about' },
]

const currentPath = Astro.url.pathname
---

<header
  id="navbar"
  class="fixed top-0 w-full z-50 bg-transparent border-b border-transparent transition-all duration-500"
>
  <div class="flex justify-between items-center px-4 sm:px-6 py-4 max-w-[1200px] mx-auto">
    <a href="/" class="font-display text-lg sm:text-xl md:text-2xl font-bold text-[#e2e8f0] hover:text-[#3b82f6] transition-colors duration-300 truncate mr-4">
      Rohail Khan Shinwari
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex gap-6 items-center">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || 
          (link.href !== '/' && currentPath.startsWith(link.href))
        return (
          <a
            href={link.href}
            class={`nav-link font-body text-sm md:text-base transition-colors duration-300 whitespace-nowrap ${
              isActive 
                ? 'text-[#3b82f6]' 
                : 'text-[#94a3b8] hover:text-[#3b82f6]'
            }`}
          >
            {link.name}
            {isActive && (
              <span class="nav-active-dot"></span>
            )}
          </a>
        )
      })}
      <button
        id="connect-btn"
        class="bg-primary text-on-primary px-6 py-2 rounded-full font-body-md text-body-md hover:bg-on-primary-fixed-variant transition-all duration-300 items-center gap-2 inline-flex hover:shadow-[0_0_20px_rgba(59,130,246,0.3)]"
      >
        Let's Connect
        <Icon name="arrow-forward" size={18} />
      </button>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      id="menu-btn"
      class="md:hidden text-[#e2e8f0] hover:text-[#3b82f6] transition-colors duration-300"
      aria-label="Toggle menu"
    >
      <Icon name="menu" />
    </button>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 right-0 z-50 w-64 transform bg-[#0f1624] border-l border-white/[0.06] shadow-2xl transition-transform duration-300 md:hidden translate-x-full"
  >
    <!-- Close button -->
    <button
      id="close-menu-btn"
      class="absolute top-5 right-5 text-[#94a3b8] hover:text-[#e2e8f0] transition-colors"
      aria-label="Close menu"
    >
      <Icon name="close" />
    </button>
    
    <div class="flex flex-col gap-6 p-6 pt-20">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || 
          (link.href !== '/' && currentPath.startsWith(link.href))
        return (
          <a
            href={link.href}
            class={`text-base font-medium transition-colors duration-300 ${
              isActive 
                ? 'text-[#3b82f6]' 
                : 'text-[#94a3b8] hover:text-[#e2e8f0]'
            }`}
          >
            {link.name}
          </a>
        )
      })}
      <button
        id="mobile-connect-btn"
        class="rounded-full bg-primary px-5 py-3 text-sm font-medium text-on-primary transition-all duration-300 hover:bg-on-primary-fixed-variant hover:shadow-[0_0_20px_rgba(59,130,246,0.3)]"
      >
        Let's Connect
      </button>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    padding-bottom: 4px;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6, #a78bfa);
    border-radius: 1px;
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }
  
  /* Active page dot indicator */
  .nav-active-dot {
    display: block;
    width: 4px;
    height: 4px;
    background-color: #3b82f6;
    border-radius: 50%;
    margin: 4px auto 0;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.6);
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const menuBtn = document.getElementById('menu-btn');
  const closeMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const connectBtn = document.getElementById('connect-btn');
  const mobileConnectBtn = document.getElementById('mobile-connect-btn');

  let isMenuOpen = false;

  // Navbar scroll effect: transparent → frosted glass.
  // Passive listener + write styles only when the state actually flips.
  let scrolled = false;
  function applyNavbarStyle(isScrolled: boolean) {
    if (isScrolled) {
      navbar.style.backgroundColor = 'rgba(10, 15, 26, 0.85)';
      navbar.style.backdropFilter = 'blur(20px)';
      navbar.style.webkitBackdropFilter = 'blur(20px)';
      navbar.style.borderBottomColor = 'rgba(255, 255, 255, 0.06)';
    } else {
      navbar.style.backgroundColor = 'transparent';
      navbar.style.backdropFilter = 'none';
      navbar.style.webkitBackdropFilter = 'none';
      navbar.style.borderBottomColor = 'transparent';
    }
  }
  window.addEventListener('scroll', () => {
    const isScrolled = window.scrollY > 50;
    if (isScrolled !== scrolled) {
      scrolled = isScrolled;
      applyNavbarStyle(scrolled);
    }
  }, { passive: true });

  // Mobile menu toggle
  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  }

  // Scroll to footer
  function scrollToFooter() {
    const footer = document.querySelector('footer');
    if (footer) {
      footer.scrollIntoView({ behavior: 'smooth' });
    }
    // Close mobile menu if open
    if (isMenuOpen) {
      toggleMenu();
    }
  }

  // Event listeners
  menuBtn.addEventListener('click', toggleMenu);
  if (closeMenuBtn) closeMenuBtn.addEventListener('click', toggleMenu);
  connectBtn.addEventListener('click', scrollToFooter);
  mobileConnectBtn.addEventListener('click', scrollToFooter);

  // Close menu when clicking a link
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });
</script>
