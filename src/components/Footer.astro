---
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Projects', href: '/projects' },
  { name: 'Blog', href: '/blog' },
  { name: 'Products', href: '/products' },
]

const email = 'Shinwarir098@gmail.com'

const socialLinks = [
  {
    name: 'Contact',
    href: `mailto:${email}`,
    icon: 'mail',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/Rohailkhan15',
    icon: 'code',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/rohail-khan-968561316?utm_source=share_via&utm_content=profile&utm_medium=member_ios',
    icon: 'connect_without_contact',
  },
]
---

<footer id="footer" class="w-full py-[120px] bg-surface border-t border-outline-variant">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 px-6 max-w-[1200px] mx-auto">
    <div class="flex flex-col gap-4">
      <div class="font-headline-sm text-headline-sm font-bold text-on-surface">Rohail</div>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-xs">
        Building the interfaces for the next generation of intelligent systems.
      </p>
      <div class="font-body-md text-body-md text-on-surface-variant mt-auto">
        © 2024 Rohail. Built for the future.
      </div>
    </div>
    <div class="flex flex-col gap-3 md:pl-12">
      <div class="font-label-caps text-label-caps text-on-surface mb-2">NAVIGATION</div>
      {navLinks.map(link => (
        <a
          href={link.href}
          class="font-body-md text-body-md text-primary font-semibold hover:text-primary transition-colors opacity-80 hover:opacity-100"
        >
          {link.name}
        </a>
      ))}
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-surface mb-2">CONNECT</div>
      {socialLinks.map(link => (
        <a
          href={link.href}
          target={link.name === 'Contact' ? '' : '_blank'}
          rel={link.name === 'Contact' ? '' : 'noopener noreferrer'}
          class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors opacity-80 hover:opacity-100 flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-[18px]">{link.icon}</span>
          {link.name}
        </a>
      ))}
    </div>
  </div>
</footer>
