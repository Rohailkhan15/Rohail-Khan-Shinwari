---
import type { Product } from '../lib/sanity'

interface Props {
  product: Product
}

const { product } = Astro.props
---

<div class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" data-status={product.status}>
  <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-[100px] -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
  
  <!-- Status Badge -->
  <div class="mb-4 flex items-center gap-3">
    <span class="font-label-caps text-label-caps bg-primary-container/10 text-primary px-3 py-1 rounded-full border border-primary/20">
      {product.status}
    </span>
    {product.price && (
      <span class="font-label-caps text-label-caps bg-secondary-container/10 text-secondary px-3 py-1 rounded-full border border-secondary/20">
        {product.price}
      </span>
    )}
  </div>

  <!-- Title -->
  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">{product.title}</h3>

  <!-- Description -->
  <p class="font-body-md text-body-md text-on-surface-variant mb-6">{product.description}</p>

  <!-- Tags -->
  <div class="flex gap-2 mt-auto mb-6">
    {(product.tags || []).slice(0, 3).map(tag => (
      <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full">
        {tag}
      </span>
    ))}
  </div>

  <!-- Links -->
  <div class="flex gap-3">
    {product.productUrl && (
      <a
        href={product.productUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-label-caps text-[11px] bg-primary-container/10 text-primary px-2.5 py-1 rounded-full border border-primary/20 hover:bg-primary-container/20 transition-colors flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[14px]">open_in_new</span>
        View Product
      </a>
    )}
    {product.github && (
      <a
        href={product.github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-label-caps text-[11px] bg-primary-container/10 text-primary px-2.5 py-1 rounded-full border border-primary/20 hover:bg-primary-container/20 transition-colors flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[14px]">code</span>
        GitHub
      </a>
    )}
  </div>
</div>
