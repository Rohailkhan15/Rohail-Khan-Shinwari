---
import Icon from './Icon.astro'
import type { Project } from '../lib/sanity'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<div class="group relative flex h-[380px] w-full flex-col rounded-2xl border border-outline-variant/10 bg-surface-container-lowest p-8 hover:border-primary/30 transition-all hover:-translate-y-1 overflow-hidden" data-status={project.status}>
  <a href={`/projects/${project.slug.current}`} class="absolute inset-0 z-0 rounded-2xl" aria-label={`View ${project.title}`}></a>

  <!-- Status Badge -->
  <div class="relative z-10 mb-4 shrink-0">
    <span class="font-label-caps text-label-caps bg-primary-container/10 text-primary px-3 py-1 rounded-full border border-primary/20">
      {project.status}
    </span>
  </div>

  <!-- Title -->
  <h3 class="relative z-10 font-headline-sm text-headline-sm text-on-surface line-clamp-2 group-hover:text-primary transition-colors shrink-0">
    {project.title}
  </h3>

  <!-- Description -->
  <p class="relative z-10 mt-3 font-body-md text-body-md text-on-surface-variant line-clamp-3 shrink-0">{project.description}</p>

  <!-- Tags & Links -->
  <div class="relative z-10 mt-auto shrink-0 pt-4">
    <div class="flex h-7 flex-wrap gap-2 overflow-hidden">
      {(project.tags || []).slice(0, 3).map(tag => (
        <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full">
          {tag}
        </span>
      ))}
    </div>

    <div class="mt-4 flex gap-3">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 font-label-caps text-[11px] bg-primary-container/10 text-primary px-2.5 py-1 rounded-full border border-primary/20 hover:bg-primary-container/20 transition-colors flex items-center gap-1"
        >
          <Icon name="code" size={14} />
          GitHub
        </a>
      )}
      {project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 font-label-caps text-[11px] bg-primary-container/10 text-primary px-2.5 py-1 rounded-full border border-primary/20 hover:bg-primary-container/20 transition-colors flex items-center gap-1"
        >
          <Icon name="open-in-new" size={14} />
          Live Demo
        </a>
      )}
    </div>
  </div>
</div>
