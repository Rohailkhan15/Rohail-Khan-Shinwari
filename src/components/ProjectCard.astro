---
import type { Project } from '../lib/sanity'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<div class="group block bg-surface-container-lowest rounded-2xl border border-outline-variant/10 p-8 hover:border-primary/30 transition-all hover:-translate-y-1 relative overflow-hidden" data-status={project.status}>
  <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-[100px] -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
  
  <!-- Status Badge -->
  <div class="mb-4">
    <span class="font-label-caps text-label-caps bg-primary-container/10 text-primary px-3 py-1 rounded-full border border-primary/20">
      {project.status}
    </span>
  </div>

  <!-- Title -->
  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">{project.title}</h3>

  <!-- Description -->
  <p class="font-body-md text-body-md text-on-surface-variant mb-6">{project.description}</p>

  <!-- Tags -->
  <div class="flex gap-2 mt-auto mb-6">
    {(project.tags || []).slice(0, 3).map(tag => (
      <span class="font-label-caps text-label-caps bg-surface-variant text-on-surface px-2 py-1 rounded-full">
        {tag}
      </span>
    ))}
  </div>

  <!-- Links -->
  <div class="flex gap-4">
    {project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-label-caps text-label-caps text-primary hover:text-primary transition-colors flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[16px]">code</span>
        GitHub
      </a>
    )}
    {project.demo && (
      <a
        href={project.demo}
        target="_blank"
        rel="noopener noreferrer"
        class="font-label-caps text-label-caps text-primary hover:text-primary transition-colors flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[16px]">open_in_new</span>
        Live Demo
      </a>
    )}
  </div>
</div>
